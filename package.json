{
  "name": "jc-compute",
  "version": "4.0.0",
  "description": "JC Compute v4 \u2014 Authority-Constrained Deterministic Causal Computation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "node src/demo.js",
    "cli": "node src/cli.js",
    "app:start": "node app/src/server.js",
    "app:cli": "node app/src/cli.js",
    "bench:storage": "node benchmarks/storage/index.js",
    "bench:lookup": "node benchmarks/lookup/index.js",
    "bench:witness": "node benchmarks/witness/index.js",
    "bench:reducer": "node benchmarks/reducer/index.js",
    "bench:frontier": "node benchmarks/frontier/index.js",
    "bench:frontier-growth": "node benchmarks/frontier-growth/index.js",
    "bench:merkle": "node benchmarks/merkle/index.js",
    "bench:sync": "node benchmarks/sync/index.js",
    "bench:compression": "node benchmarks/compression/index.js",
    "bench:kcr": "node benchmarks/kcr/index.js",
    "bench:kcr-stress": "node benchmarks/kcr-stress/index.js",
    "bench:kcr-positive": "node benchmarks/kcr-positive/runner.js",
    "bench:reachability": "node benchmarks/reachability/index.js",
    "verify:lean": "lake build",
    "verify:tla": "echo 'Run TLC on formal/tla/DeterministicReplay.tla and Convergence.tla'",
    "test:adversarial": "node --test tests/adversarial-property.test.js",
    "test:network": "node --test tests/minimal-network.test.js",
    "test:all": "node --test tests/*.test.js",
    "closure": "node --test tests/adversarial-property.test.js && node --test tests/minimal-network.test.js"
  },
  "exports": {
    "./unified": "./packages/unistack-unified/index.js",
    "./integration": "./packages/unistack-integration/index.js",
    "./oracle": "./runtime/oracle/oracle-bootstrap.js",
    "./vocabulary": "./src/vocabulary.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
