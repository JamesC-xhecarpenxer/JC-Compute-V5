# ─────────────────────────────────────────────────────────────────────────────
# UniStack — environment config
# Copy to .env and edit as needed
# ─────────────────────────────────────────────────────────────────────────────

# Ollama server URL (default: localhost:11434)
# On M1 Mac this is where Ollama's Metal-accelerated inference runs
OLLAMA_HOST=http://localhost:11434

# Primary chat model (used by /api/chat and oracle)
# Options: mistral, llama3.2, llama3.1, gemma2, phi3
CHAT_MODEL=mistral

# Fallback chat model (used if primary fails)
CHAT_MODEL_2=llama3.2

# HTTP server port
PORT=3000

# ── Oracle config (passed to createTransitionOracle) ─────────────────────────
# ORACLE_MODELS=mistral,llama3.2        # comma-separated list
# ORACLE_CONSENSUS_THRESHOLD=2
# ORACLE_MAX_IR=8
# ORACLE_TIMEOUT_MS=30000

# ── M1 performance tips ───────────────────────────────────────────────────────
# Ollama auto-uses Metal on Apple Silicon — no extra config needed.
# For 8 GB M1:  keep num_ctx=4096 (default in server.js)
# For 16 GB M1: you can raise num_ctx to 8192 in server.js ollamaChat()
# Monitor GPU: sudo powermetrics --samplers gpu_power -i 1000
